# @assistant-ui/react depende de zustand 5; @openuidev/* pide zustand 4 como peer.
# Se resuelve con zustand 4 en la raíz (para OpenUI) y la copia anidada de
# assistant-ui en su propio node_modules. legacy-peer-deps evita que npm
# aborte por ese conflicto. Debe aplicarse igual en local y en Docker.
legacy-peer-deps=true
