# --- Nexus: variables de entorno -------------------------------------------

# Secreto para cifrar (AES-256-GCM) las API keys de los usuarios.
# Genera uno con:  openssl rand -hex 32
APP_ENCRYPTION_KEY=

# URL pública de la app (cookies / redirects)
APP_URL=http://localhost:3000

# --- Usuarios -----------------------------------------------------------------
# No hay registro libre: la primera cuenta de una instalación nueva nace admin y
# los admins crean las demás en Ajustes → Usuarios. Estas cuentas (correos separados
# por comas) son admin en cada arranque; sirve para recuperar el acceso.
# NEXUS_ADMIN_EMAILS=tu@correo.com

# --- Desarrollo local --------------------------------------------------------
# Con `docker compose up -d db searxng agent` puedes usar la DB, SearXNG y el
# sidecar de agentes desde `npm run dev` (ver «Motor de agentes» más abajo):
# DATABASE_URL=postgres://plexo:plexo@localhost:5433/plexo

# --- Intelligent UI (OpenUI) -------------------------------------------------
# Las variables PLEXO_* (nombre anterior del proyecto) siguen funcionando como alias.
# Interruptor general de la UI generativa. `off` desactiva el prompt y el render.
NEXUS_OPENUI=on
# Focos donde se activa por defecto. La especificación + ejemplos de OpenUI
# cuestan ~13k tokens de prompt, así que no se inyecta en cada pregunta.
NEXUS_OPENUI_FOCUS=finance,news
# URL de teselas para los mapas de OpenUI (sin ella, el mapa no se pinta).
# MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Aprobaciones -------------------------------------------------------------
# Políticas por herramienta y tarjetas de aprobación.
NEXUS_APPROVALS=on

# --- Motor de agentes (sidecar nas-adk) --------------------------------------
# Obligatorio: todos los turnos los ejecuta el sidecar.
# Secreto compartido entre la app y el sidecar de agentes (nas-adk).
# Genera uno con:  openssl rand -hex 32
NEXUS_AGENT_SECRET=
# Ruta al repositorio de nas-adk, que se monta como contexto de build del sidecar.
# NAS_ADK_PATH=../nas-adk
# En desarrollo local (sin Compose), URL del sidecar y de vuelta al BFF:
# NEXUS_AGENT_URL=http://127.0.0.1:8090
# NEXUS_INTERNAL_URL=http://127.0.0.1:3000
# Contexto máximo por llamada al modelo en nas-adk (tokens). Por defecto 64000;
# bájalo si tu modelo tiene una ventana pequeña.
# NEXUS_AGENT_CONTEXT_TOKENS=64000

# --- Agentes autónomos ---------------------------------------------------------
# Runs simultáneos en esta instancia; los trabajos sobrantes esperan en la cola.
# NEXUS_MAX_CONCURRENT_RUNS=4
# `off` desactiva el planificador (cron, RSS, cola de trabajos).
# NEXUS_WORKER=on
# Permite conectores MCP en red privada o http. Déjalo apagado salvo que sepas lo que haces (SSRF).
# NEXUS_ALLOW_PRIVATE_CONNECTORS=off

# --- Ordenador por agente (perfil «computer» de Compose) ---------------------
# NEXUS_SANDBOXD_URL=http://sandboxd:8095
# SANDBOX_IMAGE=mcr.microsoft.com/playwright/mcp:latest

