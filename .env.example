# --- Plexo: variables de entorno -------------------------------------------

# Secreto para cifrar (AES-256-GCM) las API keys de los usuarios.
# Genera uno con:  openssl rand -hex 32
APP_ENCRYPTION_KEY=

# URL pública de la app (cookies / redirects)
APP_URL=http://localhost:3000

# --- Desarrollo local --------------------------------------------------------
# En `npm run dev` el BFF lanza el binario `hermes` del host.
# Si usas la instalación por defecto (~/.hermes), deja HERMES_HOME comentado.
# HERMES_HOME=./.hermes-data
# HERMES_BIN=hermes

# Con `docker compose up -d db searxng` puedes usar la DB y SearXNG locales:
# DATABASE_URL=postgres://plexo:plexo@localhost:5433/plexo
# SEARXNG_URL=http://localhost:8888

# --- Opcional ----------------------------------------------------------------
# Motor de extracción de páginas en Hermes (por defecto Firecrawl keyless).
# Sonar/Perplexity Search si el usuario trae su propia key:
# PERPLEXITY_API_KEY=
# FIRECRAWL_API_KEY=

# --- Intelligent UI (OpenUI) -------------------------------------------------
# Interruptor general de la UI generativa. `off` desactiva el prompt y el render.
PLEXO_OPENUI=on
# Focos donde se activa por defecto. La especificación + ejemplos de OpenUI
# cuestan ~13k tokens de prompt, así que no se inyecta en cada pregunta.
PLEXO_OPENUI_FOCUS=finance,news
# URL de teselas para los mapas de OpenUI (sin ella, el mapa no se pinta).
# MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Computer (navegador gobernado) ------------------------------------------
# Apagado por defecto: habilita el toolset `browser` de Hermes y el servicio
# Chromium. No lo enciendas sin la política y las aprobaciones probadas.
PLEXO_COMPUTER=off
PLEXO_APPROVALS=on
# BROWSER_TOKEN=
# BROWSER_SUPERVISOR_URL=http://browser:9222
# BROWSER_MAX_INSTANCES=3
# BROWSER_IDLE_MS=600000
