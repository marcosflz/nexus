# --- Plexo: variables de entorno -------------------------------------------

# Secreto para cifrar (AES-256-GCM) las API keys de los usuarios.
# Genera uno con:  openssl rand -hex 32
APP_ENCRYPTION_KEY=

# URL pública de la app (cookies / redirects)
APP_URL=http://localhost:3000

# --- Desarrollo local --------------------------------------------------------
# En `npm run dev` el BFF lanza el binario `hermes` del host.
# Si usas la instalación por defecto (~/.hermes), deja HERMES_HOME comentado.
# HERMES_HOME=./.hermes-data
# HERMES_BIN=hermes

# Con `docker compose up -d db searxng` puedes usar la DB y SearXNG locales:
# DATABASE_URL=postgres://plexo:plexo@localhost:5433/plexo
# SEARXNG_URL=http://localhost:8888

# --- Opcional ----------------------------------------------------------------
# Motor de extracción de páginas en Hermes (por defecto Firecrawl keyless).
# Sonar/Perplexity Search si el usuario trae su propia key:
# PERPLEXITY_API_KEY=
# FIRECRAWL_API_KEY=
